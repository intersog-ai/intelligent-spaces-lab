{
  "experiment": "b04_valve",
  "date": "2026-11-19",
  "method": "Per condition and design, N seeded runs (seed = trial index) of a fresh twin home (15 devices) plus a simulated flow meter on the main pipe. A leak starts at 60-120 s; the run continues 360 virtual s after it. Ground truth = the valve's physical position from the device object. A 'closed' claim is false if the valve is still open 30 s after the claim; 'claims made while water flowed' counts claims with the valve open at the moment of the claim. Escalation = a plain-words message telling people to shut the water off by hand. People: Anna at home (LAN), Mark away (push through the egress gate, needs the internet). Alarms: B01 AlarmHub, SIA-DCS over a simulated WAN to a simulated monitoring centre. Explanations are generated from each run's journal only and checked automatically: every time, percentage, flow figure, quoted message and count must match a cited record of the right kind; statements about the valve being closed (or not) are also checked against the twin's ground truth.",
  "params": {
    "trials_per_cell": 500,
    "designs": [
      "fire_and_forget",
      "ack_based",
      "state_machine"
    ],
    "ablation": {
      "condition": "hub_reboot",
      "design": "state_machine_no_journal"
    },
    "conditions": {
      "normal": "no fault",
      "valve_stuck": "valve acks every command and never moves",
      "valve_partial": "valve stops at 40% open",
      "command_lost": "each copy of cmd/valve.main dropped with p=0.5",
      "state_report_lost": "every state/valve.main report dropped for 15 s after the leak",
      "hub_reboot": "hub crashes 0-10 s after the leak, down 20-40 s; unsynced journal records lost",
      "internet_down": "internet down from -30 s to +270 s around the leak",
      "leak_event_lost": "event/leak.sink dropped; the state copy (leak: true) still arrives"
    },
    "horizon_after_leak_s": 360.0,
    "valve_travel_s": [
      4.0,
      8.0
    ],
    "flow_meter": {
      "leak_lpm_valve_open": 6.0,
      "report_on_change_lpm": 0.3,
      "heartbeat_s": 10.0
    },
    "state_machine": {
      "attempt_timeout_s": 10.0,
      "escalate_after_s": 30.0,
      "flow_zero_lpm": 0.2,
      "flow_fresh_s": 15.0,
      "flow_wait_s": 15.0,
      "ack_retry_s": 2.0,
      "max_resends": 3,
      "retry_after_escalation_s": 30.0,
      "max_attempts": 8,
      "fsync_s": 0.002
    },
    "ack_based": {
      "ack_retry_s": 3.0,
      "max_resends": 2
    },
    "alarm": {
      "format": "SIA-DCS",
      "leak_zone": 2,
      "valve_zone": 12,
      "wan_latency_s": [
        0.05,
        0.25
      ]
    },
    "wall_time_s": 64.4
  },
