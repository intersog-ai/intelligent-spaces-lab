{
  "experiment": "b03_readings",
  "date": "2026-11-19",
  "method": "Seeded simulated week (virtual time) of the B01 twin (islab.twin.build_home) with faults injected through FaultInjector and scheduled sensor faults. Three hub views read the same bus at once: naive (latest arrival wins), timestamp (islab.policy.StateStore: dedupe by event id, order and freshness by device ts) and quality (islab.readings.ReadingQuality). Identical decision code runs on each view: kitchen heating every 60 s, overheat alert, leak shut-off and valve reopen, night light on motion, doorbell notice, 22:00 house check. An oracle (first link hook and first subscriber) labels every message; views never read it. A decision is on bad data if an input came from a lying sensor and differs from truth by more than 1 degC (or wrong leak state), was superseded by a newer honest reading already delivered, was truly older than the device max age (2.5 x heartbeat), or the decision was triggered by a duplicate event copy. Decisions are recorded, not executed (open loop).",
  "params": {
    "seeds": 10,
    "days": 7,
    "decision_tick_s": 60,
    "temp_tolerance_c": 1.0,
    "faults": {
      "duplicates": "10% of state/ and event/ messages delivered twice (0.05-0.5 s later)",
      "reordering": "0-30 s uniform jitter on state/window.kitchen; ~14 airings/day of 5-60 s",
      "clock_drift": "temp.kitchen clock 2 s/hour behind the hub, all week (336 s at day 7)",
      "spike": "day 0 ~14:00, one temp.kitchen report +15 degC",
      "leak_oneshot": "day 2 ~03:00, one leak event, state stays dry; truly wet 2 h; person reads phone 07:10",
      "stuck": "day 1 ~08:00, temp.kitchen stuck 12 h (same value, fresh timestamps)",
      "dead_battery": "day 5 ~10:00, leak.sink last gasp then silence"
    },
    "legitimate_events": {
      "real_leak": "day 1 ~10:00, 20 min, state wet + event, then dry",
      "real_step": "day 3 ~12:00, +5 degC for 30 min (fast but real)",
      "cooking": "daily 18:00, +3 degC over 3 min for 45 min"
    },
    "quality_layer": {
      "max_age": "2.5 x device heartbeat (temp 150 s, thermostat 75 s, battery sensors 750 s)",
      "skew": "rolling median of 15 (hub receive - device ts); alert above 60 s",
      "rate_limit_temp_c_per_s": 0.05,
      "range_temp_c": [
        -30,
        60
      ],
      "stuck": "identical values for 20 min (>= 15 reports)",
      "disagreement": "temp.kitchen vs thermo.kitchen > 1.5 degC for 10 min",
      "latch": "leak/smoke events clear only on device wet->dry or person confirmation"
    }
  },
