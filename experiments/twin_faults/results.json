{
  "experiment": "twin_faults",
  "date": "2026-11-19",
  "method": "Per fault type, N seeded trials (seed = trial index) of a fresh twin home. Fault injected at t=0; after 5 s boot a minimal client sends one command and waits 30 virtual s. CONFIRMED = a state/<device> message with the expected attributes and device ts > command time (contract rule). Outcomes are mutually exclusive: confirmed / ack_not_confirmed / no_ack. ttc = time from command to confirming state, virtual seconds.",
  "params": {
    "trials": 200,
    "timeout_s": 30.0,
    "boot_s": 5.0,
    "faults": {
      "none": {
        "target": "valve.main close",
        "setup": "no fault"
      },
      "link_drop": {
        "target": "valve.main close",
        "setup": "30% drop on cmd/ack/state of the device"
      },
      "link_delay": {
        "target": "valve.main close",
        "setup": "+5 s on cmd/ack/state"
      },
      "link_duplicate": {
        "target": "valve.main close",
        "setup": "50% of cmd/ack/state messages delivered twice"
      },
      "link_reorder": {
        "target": "valve.main close",
        "setup": "uniform 0-10 s jitter on cmd/ack/state (reorders)"
      },
      "stuck": {
        "target": "valve.main close",
        "setup": "actuator acks, never moves"
      },
      "partial": {
        "target": "valve.main close",
        "setup": "valve stops at 40%"
      },
      "offline": {
        "target": "valve.main close",
        "setup": "device silent, ignores commands"
      },
      "stale": {
        "target": "valve.main close",
        "setup": "repeats last snapshot with old ts; acks commands"
      },
      "clock_skew_behind": {
        "target": "valve.main close",
        "setup": "device clock 120 s behind hub"
      },
      "clock_skew_ahead": {
        "target": "valve.main close",
        "setup": "device clock 120 s ahead of hub"
      },
      "battery_dead": {
        "target": "lock.front unlock",
        "setup": "battery lock: last gasp then silence"
      },
      "internet_down": {
        "target": "valve.main close",
        "setup": "WAN down; local bus intact"
      },
      "hostile_name": {
        "target": "valve.main close",
        "setup": "prompt-injection friendly name (agent-layer fault)"
      }
    },
    "base_latency_s": 0.01
  },
